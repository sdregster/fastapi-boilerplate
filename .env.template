# База данных
APP_CONFIG__DB__URL=postgresql+asyncpg://postgres:your_password@localhost:5432/fastapi_auth
APP_CONFIG__DB__ECHO=false

# JWT токены
APP_CONFIG__JWT__SECRET_KEY=your_super_secret_key_here_change_in_production
APP_CONFIG__JWT__ALGORITHM=HS256
APP_CONFIG__JWT__ACCESS_TOKEN_EXPIRE_MINUTES=30
APP_CONFIG__JWT__REFRESH_TOKEN_EXPIRE_DAYS=7
APP_CONFIG__JWT__ISSUER=fastapi-auth-app
APP_CONFIG__JWT__AUDIENCE=fastapi-auth-users